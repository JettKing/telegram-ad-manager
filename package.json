{
  "name": "tg-ad-manager",
  "version": "1.1.0",
  "private": true,
  "description": "Telegram advertising management SaaS foundation",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "concurrently -k \"pnpm --filter @tg-ad-manager/api dev\" \"pnpm --filter @tg-ad-manager/web dev\"",
    "build": "pnpm run build:web && pnpm run build:api",
    "build:web": "pnpm --filter @tg-ad-manager/web build",
    "build:api": "pnpm --filter @tg-ad-manager/api build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "vitest run && tsx scripts/test-production-finance-sqlite.ts",
    "db:check": "tsx scripts/check-migrations.ts",
    "cf:config:check": "tsx scripts/validate-production-config.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "wrangler": "4.164.0"
  }
}
