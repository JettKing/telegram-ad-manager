{
  "name": "tg-ad-manager-api",
  "account_id": "bf9869d76a7fcbd9f75aefc5f98f3fbb",
  "main": "apps/api/src/worker.ts",
  "compatibility_date": "2026-11-17",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    "D1_SCHEMA_CONTRACT": "production-0009",
    "WEB_APP_ORIGIN": "https://telegram-ad-manager.pages.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tg-ad-manager",
      "database_id": "d9a4ad54-d504-40d6-abd5-a3e978a8ff5a",
      "migrations_dir": "apps/api/migrations"
    }
  ],
  "queues": {
    "producers": [
      { "binding": "PUBLISH_QUEUE", "queue": "tg-ad-manager-publish" }
    ]
  },
  "triggers": { "crons": ["*/5 * * * *"] }
}
