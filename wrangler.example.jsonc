{
  "name": "tg-ad-manager-api",
  "main": "apps/api/src/worker.ts",
  "compatibility_date": "2026-11-17",
  "observability": { "enabled": true },
  "migrations": { "path": "apps/api/migrations" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "REPLACE_WITH_CLOUDFLARE_D1_NAME",
      "database_id": "REPLACE_WITH_CLOUDFLARE_D1_ID",
      "migrations_dir": "apps/api/migrations"
    }
  ],
  "queues": {
    "producers": [
      { "binding": "PUBLISH_QUEUE", "queue": "REPLACE_WITH_PUBLISH_QUEUE_NAME" }
    ],
    "consumers": [
      { "queue": "REPLACE_WITH_PUBLISH_QUEUE_NAME", "max_batch_size": 10, "max_retries": 5 }
    ]
  },
  "triggers": { "crons": ["*/5 * * * *"] }
}
